# Copy this file to .env and fill in your values

# Required: OpenAI API key (used for GPT-4o agent brain + vision enhancement)
OPENAI_API_KEY=sk-...

# Optional: Override the agent LLM model (default: gpt-4o)
AGENT_MODEL=gpt-4o

# Optional: Path to potrace binary for flat logo vectorization (fallback to contour method if absent)
# Windows example: C:\Program Files\potrace\potrace.exe
# macOS: /opt/homebrew/bin/potrace
# Linux: /usr/bin/potrace
POTRACE_BIN=potrace

# Optional: Default output directory for generated EPS files
OUTPUT_DIR=./output
