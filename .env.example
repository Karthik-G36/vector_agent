# Copy this file to .env and fill in values as needed

# Optional: Output directory for generated files (default: ./output)
OUTPUT_DIR=./output

# Optional: Use gpt-image-1 to enhance the image before PIL upscaling.
# When true: gpt-image-1 enhances resolution -> PIL 4x LANCZOS + sharpen
# When false (default): PIL 4x LANCZOS + sharpen only (no API call)
# Requires: OPENAI_API_KEY
CALL_AGENT=false
OPENAI_API_KEY=sk-...

# Optional: Segment with SAM 2 (Segment Anything Model 2) in automatic mode.
# Produces one binary mask per region, traces each separately, composes a layered SVG.
# Works on any image type (logos and photos) without text prompts.
# Model (~300 MB) downloaded automatically on first run via huggingface_hub.
# GPU strongly recommended; CPU works but is slow (30–120 s per image).
# Requires: pip install sam2 huggingface_hub torch torchvision
USE_SAM2=false

# Optional: Remove background before PNG→SVG tracing (uses rembg / U2Net model)
# Model (~170 MB) is downloaded automatically on first run
# Requires: pip install rembg onnxruntime
REMOVE_BG=false

# Optional: Use vtracer for PNG→SVG instead of Inkscape.
# vtracer handles gradient logos better — no concentric rings or color bleed.
# Requires: pip install vtracer
USE_VTRACER=false

# Optional: Run Real-ESRGAN after upscaling for AI-sharpened edges (4x)
# Requires: torch + torchvision + realesrgan + basicsr (see requirements.txt)
# Model (~67 MB) is downloaded automatically on first run
USE_REALESRGAN=false

# Optional: Real-ESRGAN tile size for processing (default: 512)
# 512 = safe for CPU and low-VRAM GPU
# 0   = process whole image at once (faster on high-VRAM GPU, may OOM on CPU)
REALESRGAN_TILE=512

# ── API settings ──────────────────────────────────────────────────────────────
# How long generated files are kept before auto-deletion (default: 60 minutes)
FILE_TTL_MINUTES=60
